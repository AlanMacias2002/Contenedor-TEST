# Copia este archivo a .env y define las tres llaves.
# 🔴 .env contiene secretos: no lo compartas ni lo subas a git.
#
# Genera cada llave con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Nivel lectura: consultar, resolver, simular exportación, estado de trabajos
BRIDGE_KEY_LECTURA=
# Nivel buffer: lo anterior + escribir en la DB Buffer (cotizaciones, equivalencias, altas, sync)
BRIDGE_KEY_BUFFER=
# Nivel odoo: lo anterior + escribir en Odoo (exportar cotización, inyectar partidas)
BRIDGE_KEY_ODOO=

# Nombre de la red Docker de n8n (ver README, paso 1)
BRIDGE_RED=bbinco-net

# Página /docs con el contrato interactivo (true/false)
BRIDGE_DOCS=true

# Simulación: segundos que tarda cada lote de una sincronización
BRIDGE_MOCK_SEGUNDOS_POR_LOTE=2
# Simulación: retraso del escenario "lento"
BRIDGE_MOCK_LENTO_SEGUNDOS=5
